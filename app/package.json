{
  "name": "echoecho-orb",
  "productName": "echoecho",
  "version": "0.1.0",
  "private": true,
  "description": "echoecho's menu-bar portal: the blob, the workspace, and echoecho's Mac",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "demo": "ECHOECHO_ORB_DEMO=1 electron .",
    "smoke": "ECHOECHO_ORB_SMOKE=1 xvfb-run -a electron --no-sandbox .",
    "smoke:demo": "ECHOECHO_ORB_SMOKE=1 ECHOECHO_ORB_DEMO=1 xvfb-run -a electron --no-sandbox .",
    "smoke:control": "ECHOECHO_ORB_SMOKE_CONTROL=1 xvfb-run -a electron --no-sandbox .",
    "icon": "node tools/make-iconset.js",
    "test:vnc-e2e": "bash test/vnc-e2e.sh"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^38.2.0"
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "ws": "^8.18.0"
  }
}
